# Copy to `.env` before `docker compose up`.  `.env` is gitignored.

# Host UID so files the containers write to ./logs, ./dags are owned by you, not root.
# On macOS/Linux:  echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Fernet key for encrypting connection secrets in the metadata DB.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Airflow 3 signs internal + REST API JWTs with this secret. Any long random string.
# Generate:  openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=

# Admin user created by airflow-init (UI login at http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Default AWS region for the aws_default connection / provider operators.
AWS_DEFAULT_REGION=us-east-1

# Project S3 bucket (data plane lives in us-west-2; Glue/Athena run in us-east-1 — see PLAN_v2.md).
STREAMING_S3_BUCKET=acme-dw-streaming-xs2026
