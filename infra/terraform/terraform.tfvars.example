# Copy to terraform.tfvars and adjust. All have defaults except secrets.

# project = "streaming-dw"
# env     = "dev"

# aws_region  = "us-east-1"   # Glue/Athena/Lambda/Redshift/Kafka
# data_region = "us-west-2"   # pre-existing data bucket

# data_bucket        = "acme-dw-streaming-xs2026"
# manage_data_bucket = true   # set false (and skip the import) to leave the bucket unmanaged
# ops_bucket         = "acme-dw-streaming-xs2026-use1-ops"

# --- Kafka EC2 ---
# kafka_instance_type = "t3.small"
# key_pair_name       = ""              # SSM-only access if empty
# ssh_ingress_cidr    = "1.2.3.4/32"    # your IP, optional

# --- Redshift ---
# redshift_base_capacity = 8
# Set the password out-of-band, do NOT commit it:
#   export TF_VAR_redshift_admin_password='...'
# Leave unset to have Redshift manage the admin password in Secrets Manager.

# --- Networking (optional; default VPC is used if empty) ---
# vpc_id     = "vpc-xxxx"
# subnet_ids = ["subnet-a", "subnet-b", "subnet-c"]
